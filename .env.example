HOST=127.0.0.1
PORT=4310
APP_URL=http://127.0.0.1:4310
# Obligatoire : mot de passe long et unique. Aucun accès sans mot de passe.
ADMIN_PASSWORD=
# Générer : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MEDIA_SECRET=
DATA_DIR=./data
MAX_UPLOAD_MB=1024
MAX_STORAGE_MB=5120
# OAuth Google : callback APP_URL/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion Meta par jeton de Page ; jamais transmis au navigateur.
META_GRAPH_VERSION=v24.0
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_USER_ID=
# Optionnel : publication TikTok via le compte Buffer, mode choisi pour chaque vidéo.
BUFFER_API_KEY=
BUFFER_TIKTOK_CHANNEL_ID=
# Facultatif : Reels Facebook et Instagram via Buffer, sans application Meta privée.
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
